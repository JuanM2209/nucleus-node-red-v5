# Derived from the official node-red-docker `docker-custom/Dockerfile.custom`.
# Eight deltas, each marked NUCLEUS DELTA below. Keep them minimal so upstream
# changes stay easy to merge.
ARG ARCH=amd64
ARG NODE_VERSION=24
ARG OS=alpine

#### Stage BASE ########################################################################################################
FROM ${ARCH}/node:${NODE_VERSION}-${OS} AS base

# Copy scripts
COPY scripts/*.sh /tmp/
COPY healthcheck.js /

# Install tools, create Node-RED app and data dir, add user and set rights
RUN set -ex && \
    apk add --no-cache \
        bash \
        tzdata \
        curl \
        openssl \
        ca-certificates \
        udev && \
    mkdir -p /usr/src/node-red /data && \
    deluser --remove-home node && \
    adduser -h /usr/src/node-red -D -H node-red -u 1000 && \
    chown -R node-red:root /data && chmod -R g+rwX /data && \
    chown -R node-red:root /usr/src/node-red && chmod -R g+rwX /usr/src/node-red
    # chown -R node-red:node-red /data && \
    # chown -R node-red:node-red /usr/src/node-red

# Set work directory
WORKDIR /usr/src/node-red

# NUCLEUS DELTA 6b: git, openssh-client, nano and iputils are not installed (Projects is
# disabled and nothing in the Tyrion palettes shells out to them), so the upstream
# known_hosts / ssh_config setup lines are dropped with them. -9.1 MB.

# package.json contains Node-RED NPM module and node dependencies
COPY package.json .
COPY scripts/entrypoint.sh .

#### Stage BUILD #######################################################################################################
FROM base AS build

# Install Build tools
RUN apk add --no-cache --virtual buildtools build-base linux-headers udev python3 && \
    npm install --unsafe-perm --no-update-notifier --no-fund --only=production && \
    /tmp/remove_native_gpio.sh && \
    npm rebuild --build-from-source classic-level && \
    sh /tmp/elf-gate.sh /usr/src/node-red/node_modules && \
    sh /tmp/prune-node-modules.sh /usr/src/node-red/node_modules && \
    cp -R node_modules prod_node_modules

# NUCLEUS DELTA 5 (in the RUN above): scripts/elf-gate.sh fails the build if any
# native addon that would load on linux/arm/musl is a glibc-only prebuild with no
# local build/Release. That is the exact shape of the classic-level crash; the
# gate makes any recurrence a build error instead of a field crash loop.

# NUCLEUS DELTA 4 (in the RUN above): classic-level is rebuilt from source.
# It ships prebuilds/linux-arm/classic-level.armv7.node built against GLIBC
# and — unlike serialport and bcrypt, which both ship a .musl variant — has
# no musl build for arm. node-gyp-build loads the glibc binary anyway on
# Alpine, and it SEGFAULTS the whole process on armv7 the moment a flow
# instantiates it (the Tyrion Cloud node uses level -> classic-level), which
# a --restart policy turns into a crash loop rather than a visible error.
# Compiling here links it against musl. This stage has build-base +
# linux-headers + python3, so it is the only place it can be done.

#### Stage RELEASE #####################################################################################################
FROM base AS release
ARG BUILD_DATE
ARG BUILD_VERSION
ARG BUILD_REF
ARG NODE_RED_VERSION
ARG ARCH
ARG TAG_SUFFIX=default

LABEL org.label-schema.build-date=${BUILD_DATE} \
    org.label-schema.docker.dockerfile=".docker/Dockerfile.alpine" \
    org.label-schema.license="Apache-2.0" \
    org.label-schema.name="Node-RED" \
    org.label-schema.version=${BUILD_VERSION} \
    org.label-schema.description="Low-code programming for event-driven applications." \
    org.label-schema.url="https://nodered.org" \
    org.label-schema.vcs-ref=${BUILD_REF} \
    org.label-schema.vcs-type="Git" \
    org.label-schema.vcs-url="https://github.com/node-red/node-red-docker" \
    org.opencontainers.image.source="https://github.com/node-red/node-red-docker" \
    org.label-schema.arch=${ARCH} \
    authors="Dave Conway-Jones, Nick O'Leary, James Thomas, Raymond Mouthaan"

# NUCLEUS DELTA 3 (in the apk block above): `udev` is added to the base
# packages. Upstream ships it only inside install_devtools.sh, which DELTA 2
# removes; without udevadm, serialport's SerialPort.list() rejects with
# `spawn udevadm ENOENT` and the port-scan button in every serial node's
# config dialog stops working.

# NUCLEUS DELTA 1: --chown here instead of a later `RUN chown -R`, which would
# duplicate the whole node_modules tree into a second layer (~116 MB).
COPY --from=build --chown=node-red:root /usr/src/node-red/prod_node_modules ./node_modules

# Chown, install devtools & Clean up
# NUCLEUS DELTA 2: devtools (build-base + linux-headers + udev + python3, ~200 MB)
# are NOT installed in the release image. Every palette this device needs is
# already compiled in the build stage above, so the compiler is dead weight at
# runtime. Cost: Manage Palette cannot build a native addon on the device --
# add the module to package.json and rebuild the image instead.
RUN rm -r /tmp/*

# NUCLEUS DELTA 7: the system npm is dead weight at runtime. entrypoint.sh runs node
# directly, and Node-RED's Manage Palette resolves its OWN bundled copy via
# require.resolve('npm/package.json') -> node_modules/npm. Write the cache config
# with the bundled copy, then drop /usr/local/lib/node_modules. -13.8 MB.
# The node binary from node:22-alpine/arm is shipped UNSTRIPPED (4.7 MB .symtab,
# 10.2 MB .strtab, .debug_*); strip --strip-all keeps .dynsym and every allocated
# section byte-identical. -15.9 MB. Both only materialise thanks to DELTA 8.
RUN node node_modules/npm/bin/npm-cli.js config set cache /data/.npm --global && \
    rm -rf /usr/local/lib/node_modules && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack && \
    apk add --no-cache --virtual .strip-deps binutils && \
    strip --strip-all /usr/local/bin/node && \
    apk del .strip-deps 

USER node-red

# Env variables
ENV NODE_RED_VERSION=$NODE_RED_VERSION \
    NODE_PATH=/usr/src/node-red/node_modules:/data/node_modules \
    PATH=/usr/src/node-red/node_modules/.bin:${PATH} \
    FLOWS=flows.json

# ENV NODE_RED_ENABLE_SAFE_MODE=true    # Uncomment to enable safe start mode (flows not running)
# ENV NODE_RED_ENABLE_PROJECTS=true     # Uncomment to enable projects option

# Expose the listening port of node-red
EXPOSE 1880

# Add a healthcheck (default every 30 secs)
HEALTHCHECK CMD node /healthcheck.js

# ENTRYPOINT ["npm", "start", "--cache", "/data/.npm", "--", "--userDir", "/data"]
ENTRYPOINT ["./entrypoint.sh"]

#### Stage FINAL ######################################################################################################
# NUCLEUS DELTA 8: everything above that deletes files living in the node:22-alpine base
# layer (system npm, apk packages, the unstripped node) would otherwise only write
# whiteouts - the bytes stay in the lower layer and the pulled/loaded image does not
# shrink. Copying the finished release rootfs into a scratch stage collapses it to a
# single layer, which is also the friendliest shape for the Docker 18.03 docker-load path.
# COPY between stages preserves uid/gid; tools/verify-image.sh checks /data is 1000:0.
FROM scratch AS final
ARG NODE_RED_VERSION
ARG BUILD_DATE
ARG BUILD_VERSION
COPY --from=release / /
WORKDIR /usr/src/node-red
USER node-red
ENV NODE_RED_VERSION=$NODE_RED_VERSION \
    NODE_PATH=/usr/src/node-red/node_modules:/data/node_modules \
    PATH=/usr/src/node-red/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    FLOWS=flows.json
LABEL org.label-schema.build-date=${BUILD_DATE} \
    org.label-schema.name="Node-RED" \
    org.label-schema.version=${BUILD_VERSION} \
    org.label-schema.description="Node-RED 5 for Nucleus armv7 edge devices, Tyrion palette included" \
    org.opencontainers.image.source="https://github.com/JuanM2209/nucleus-node-red-v5"
EXPOSE 1880
HEALTHCHECK CMD node /healthcheck.js
ENTRYPOINT ["./entrypoint.sh"]
