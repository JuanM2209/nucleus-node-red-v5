{
    "name": "nucleus-node-red-v5",
    "version": "5.0.6",
    "description": "Node-RED 5 for Nucleus edge devices with the Tyrion Integration palette baked in. Two deliberate exclusions/overrides are documented in the repo README: @tyrion-integration/node-red-contrib-nucleus-services-cloud (level@^4 cannot build on Node 22), and @openp4nr/modbus-serial (segfaults on armv7 in connectRTUBuffered; overridden to upstream modbus-serial).",
    "license": "Apache-2.0",
    "main": "node_modules/node-red/red/red.js",
    "scripts": {
        "start": "node $NODE_OPTIONS node_modules/node-red/red.js $FLOWS",
        "debug": "node --inspect=0.0.0.0:9229 $NODE_OPTIONS node_modules/node-red/red.js $FLOWS"
    },
    "dependencies": {
        "node-red": "5.0.6",
        "@tyrion-integration/cumulus-convection-cloud": "1.2.2",
        "@tyrion-integration/node-red-contrib-nucleus-services-diagnostics": "0.13.1",
        "@tyrion-integration/node-red-contrib-nucleus-services-io": "0.12.1",
        "@tyrion-integration/nucleus-convection-diagnostics": "1.0.2",
        "@tyrion-integration/nucleus-convection-io": "1.0.2",
        "node-red-contrib-tyrion": "1.1.24",
        "node-red-contrib-aedes": "1.3.0",
        "node-red-contrib-cip-ethernet-ip": "1.1.3",
        "node-red-contrib-counter": "0.1.6",
        "node-red-contrib-fs": "1.4.1",
        "node-red-contrib-modbus": "5.60.2",
        "node-red-contrib-mqtt-sparkplug-plus": "3.1.1",
        "node-red-contrib-socketcan": "1.4.2",
        "node-red-contrib-ui-led": "0.4.11",
        "node-red-contrib-unsafe-function": "0.8.0",
        "node-red-dashboard": "3.6.6",
        "node-red-node-ui-table": "0.4.5"
    },
    "overrides": {
        "@openp4nr/modbus-serial": "npm:modbus-serial@8.0.25"
    }
}
